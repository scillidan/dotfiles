// Zellij theme pair for terminal-theme-switch: `zellij action set-dark-theme`
// and `set-light-theme` switch between these two.
// Colours come from the old tmux config (Share/caches/dotfiles.arch/.tmux.conf)
// so the switcher produces the same look as the rest of the toolchain.
themes {
    vanta-dark {
        fg "#f8fafc"
        bg "#000000"
        black "#1a1a1a"
        red "#ef4444"
        green "#22c55e"
        yellow "#e2e8f0"
        blue "#60a5fa"
        magenta "#c084fc"
        cyan "#22d3ee"
        white "#e2e8f0"
        orange "#f97316"
    }
    vanta-light {
        fg "#0f172a"
        bg "#e2e8f0"
        black "#64748b"
        red "#dc2626"
        green "#059669"
        yellow "#ca8a04"
        blue "#2563eb"
        magenta "#9333ea"
        cyan "#0891b2"
        white "#f8fafc"
        orange "#ea580c"
    }
}

theme_dark "vanta-dark"
theme_light "vanta-light"
