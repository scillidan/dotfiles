// P2 baseline: verified minimal behavior from P1.
// Full pre-migration config is preserved in config.full.kdl; restore that to roll back.
// Intentionally no zjstatus, layouts, serialization, or custom keybinds yet.
default_shell "cmd.exe"
default_layout "compact"
session_serialization true
serialize_pane_viewport false
show_startup_tips false
show_release_notes false
// Keep tab names as authored in layouts (all-digit names are never replaced by
// the focused pane's title, which for Clink-in-cmd is the long
// "C:\Windows\system32\cmd.exe - ...zellij-autorun.cmd" string).
tab_name_to_number false

// tab_bar built-in shows "1 2 3" with the active tab highlighted; "compact"
// would spend its space on the pane title, which is the long cmd path.
default_tab_bar false
default_layout "default"

// P5 5A: Ctrl-g is the Zellij prefix. The default tmux layer has no digit
// bindings, so tab jumps are added; its other bindings stay as shipped.
// WezTerm keeps Ctrl-a as its leader for the outer workspace layer.
keybinds {
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Tmux"; }
    }
    tmux {
        bind "Ctrl g" { Write 7; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        // Translate the focused pane into a pane on the right.
        bind "t" {
            Run "bash" "-lc" "zellij action new-pane --direction right -- bash $USERHOME/Share/scripts/translate-pane.sh right";
            SwitchToMode "Normal";
        }
    }
}
