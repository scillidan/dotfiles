// Swap layouts based on https://zellij.dev/documentation/swap-layouts.html
// (tiled: vertical / horizontal; floating: staggered / enlarged / spread).
// The zjstatus default_tab_template lives in each session layout instead.
layout {
    swap_tiled_layout name="vertical" {
        tab max_panes=2 {
            pane split_direction="vertical" {
                pane
                pane
            }
        }
        tab max_panes=3 {
            pane split_direction="vertical" {
                pane
                pane {
                    pane
                    pane
                }
            }
        }
        tab min_panes=4 {
            pane split_direction="vertical" {
                pane
                pane {
                    pane
                    pane
                    pane
                }
            }
        }
    }

    swap_tiled_layout name="horizontal" {
        tab max_panes=2 {
            pane
            pane
        }
        tab max_panes=3 {
            pane {
                pane
                pane
            }
            pane
        }
        tab min_panes=4 {
            pane {
                pane
                pane
                pane
            }
            pane
        }
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=1 {
            pane {
                width "90%"
                height "90%"
                x "5%"
                y "5%"
            }
        }
        floating_panes max_panes=2 {
            pane {
                width "45%"
                height "90%"
                x "1%"
                y "5%"
            }
            pane {
                width "45%"
                height "90%"
                x "50%"
                y "5%"
            }
        }
        floating_panes min_panes=3 {
            pane {
                width "45%"
                height "45%"
                x "1%"
                y "1%"
            }
            pane {
                width "45%"
                height "45%"
                x "50%"
                y "1%"
            }
            pane {
                width "45%"
                height "45%"
                x "1%"
                y "50%"
            }
        }
    }
}
