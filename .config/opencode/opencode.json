{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "mode": "primary",
      "model": "kimi-code/kimi-k2.7-code-highspeed",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "plan": {
      "mode": "primary",
      "model": "kimi-code/kimi-k2.7-code-highspeed",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "enabled_providers": [
    "deepseek",
    "kimi-code"
  ],
  "formatter": true,
  "mcp": {
    "servers": {
      "agnix": {
        "type": "local",
        "command": [
          "agnix-mcp"
        ]
      },
      "cq": {
        "type": "local",
        "command": [
          "cq",
          "mcp"
        ]
      },
      "fff": {
        "type": "local",
        "command": [
          "fff-mcp"
        ]
      },
      "aseprite": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--python",
          "3.13",
          "--module",
          "aseprite_mcp"
        ],
        "cwd": "C:/Users/User/Local/Srv/aseprite-mcp",
        "environment": {
          "ASEPRITE_PATH": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Aseprite"
        }
      },
      "blender-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-for-blender"
        ],
        "environment": {
          "BLENDER_HOST": "localhost",
          "BLENDER_PORT": "9876"
        }
      },
      "gimp-mcp": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "gimp_mcp_server.py"
        ],
        "cwd": "C:/Users/User/Local/Srv/gimp-mcp"
      },
      "material-maker": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "mm-mcp"
        ],
        "cwd": "C:/Users/User/Local/Srv/Tool-MaterialMaker-MCP",
        "environment": {
          "MM_GODOT_BINARY": "C:\\Users\\User\\Local\\Opt\\Godot_v4.6.3\\Godot_v4.6.3-stable_win64_console.exe",
          "MM_PROJECT_PATH": "C:\\Users\\User\\Local\\Srv\\material-maker",
          "MM_OUTPUT_DIR": "C:\\Users\\User\\output_mm",
          "MM_IDLE_EXIT_MINUTES": "120"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest"
        ]
      },
      "windbg": {
        "type": "local",
        "command": [
          "mcp-windbg"
        ],
        "disabled": true,
        "environment": {
          "_NT_SYMBOL_PATH": "SRV*C:\\Symbols*https://msdl.microsoft.com/download/symbols"
        }
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:OPENCODE_MCP_GITHUB}"
        }
      },
      "godot-mcp": {
        "type": "remote",
        "url": "http://localhost:9080/mcp/"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*find*",
      "effect": "deny"
    }
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@latest",
    "@slkiser/opencode-quota@latest",
    "{env:USERHOME}\\Local\\Source\\opencode\\ponytail\\.opencode\\plugins"
  ],
  "providers": {
    "deepseek": {
      "name": "DeepSeek",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "effort": "high"
            }
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "effort": "high"
            }
          }
        }
      }
    },
    "kimi-code": {
      "name": "Kimi Code",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "apiKey": "{env:KIMI_API_KEY}",
        "baseURL": "https://api.kimi.com/coding/v1"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "effort": "high"
            }
          }
        },
        "kimi-k2.7-code-highspeed": {
          "name": "Kimi K2.7 Code (HighSpeed)",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      }
    },
    "openai": {}
  },
  "shell": "cmd",
  "skills": [
    "~/.agents/personal-skills"
  ],
  "update": "disable"
}
