{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "mode": "primary",
      "model": "kimi-code/k3.1-pro",
      "permissions": [
        { "action": "shell", "effect": "allow", "resource": "*" },
        { "action": "edit", "effect": "allow", "resource": "*" }
      ]
    },
    "plan": {
      "mode": "primary",
      "model": "kimi-code/k3.1-pro",
      "permissions": [
        { "action": "shell", "effect": "deny", "resource": "*" },
        { "action": "edit", "effect": "deny", "resource": "*" }
      ]
    },
    "explore": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "permissions": [
        { "action": "shell", "effect": "deny", "resource": "*" },
        { "action": "edit", "effect": "deny", "resource": "*" }
      ]
    },
    "review": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "permissions": [
        { "action": "shell", "effect": "deny", "resource": "*" },
        { "action": "edit", "effect": "deny", "resource": "*" }
      ]
    },
    "research": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "permissions": [
        { "action": "webfetch", "effect": "allow", "resource": "*" },
        { "action": "websearch", "effect": "allow", "resource": "*" },
        { "action": "shell", "effect": "deny", "resource": "*" },
        { "action": "edit", "effect": "deny", "resource": "*" }
      ]
    }
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 40000 },
    "buffer": 20000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "deepseek", "effect": "allow" },
    { "action": "provider.use", "resource": "kimi-code", "effect": "allow" }
  ],
  "formatter": true,
  "mcp": {
    "servers": {
      "agnix": {
        "command": ["agnix-mcp"],
        "type": "local"
      },
      "aseprite": {
        "command": ["uv", "run", "--python", "3.13", "--module", "aseprite_mcp"],
        "cwd": "{env:USERHOME}/Local/Srv/aseprite-mcp",
        "enabled": false,
        "environment": {
          "ASEPRITE_PATH": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Aseprite"
        },
        "type": "local"
      },
      "blender-mcp": {
        "command": ["uvx", "mcp-for-blender"],
        "enabled": false,
        "environment": {
          "BLENDER_HOST": "localhost",
          "BLENDER_PORT": "9876"
        },
        "type": "local"
      },
      "context7": {
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        },
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "cq": {
        "command": ["cq", "mcp"],
        "type": "local"
      },
      "fff": {
        "command": ["fff-mcp"],
        "type": "local"
      },
      "gimp-mcp": {
        "command": ["uv", "run", "gimp_mcp_server.py"],
        "cwd": "{env:USERHOME}/Local/Srv/gimp-mcp",
        "enabled": false,
        "type": "local"
      },
      "github": {
        "enabled": false,
        "headers": {
          "Authorization": "Bearer {env:OPENCODE_MCP_GITHUB}"
        },
        "oauth": false,
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      },
      "godot-mcp": {
        "enabled": false,
        "type": "remote",
        "url": "http://localhost:9080/mcp/"
      },
      "material-maker": {
        "command": ["uv", "run", "mm-mcp"],
        "cwd": "{env:USERHOME}/Local/Srv/Tool-MaterialMaker-MCP",
        "enabled": false,
        "environment": {
          "MM_GODOT_BINARY": "{env:USERHOME}\\Local\\Opt\\Godot_v4.6.3\\Godot_v4.6.3-stable_win64_console.exe",
          "MM_IDLE_EXIT_MINUTES": "120",
          "MM_OUTPUT_DIR": "{env:USERHOME}\\output_mm",
          "MM_PROJECT_PATH": "{env:USERHOME}\\Local\\Srv\\material-maker"
        },
        "type": "local"
      },
      "playwright": {
        "command": ["npx", "@playwright/mcp@latest"],
        "enabled": false,
        "type": "local"
      },
      "windbg": {
        "command": ["mcp-windbg"],
        "enabled": false,
        "environment": {
          "_NT_SYMBOL_PATH": "SRV*C:\\Symbols*https://msdl.microsoft.com/download/symbols"
        },
        "type": "local"
      }
    }
  },
  "permissions": [
    { "action": "webfetch", "effect": "allow", "resource": "*" },
    { "action": "websearch", "effect": "allow", "resource": "*" },
    { "action": "shell", "effect": "allow", "resource": "*" },
    { "action": "shell", "effect": "deny", "resource": "*findstr*" },
    { "action": "shell", "effect": "deny", "resource": "*dir * /s*" }
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@latest",
    "@slkiser/opencode-quota@latest",
    "{env:USERHOME}\\Local\\Source\\opencode\\ponytail\\.opencode\\plugins"
  ],
  "providers": {
    "deepseek": {
      "models": {
        "deepseek-flash": {
          "capabilities": {
            "input": ["text"],
            "output": ["text"]
          },
          "settings": {
            "thinking": {
              "effort": "high",
              "type": "enabled"
            }
          }
        },
        "deepseek-v4-pro": {
          "capabilities": {
            "input": ["text"],
            "output": ["text"]
          },
          "settings": {
            "thinking": {
              "effort": "high",
              "type": "enabled"
            }
          }
        }
      },
      "name": "DeepSeek",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "https://api.deepseek.com"
      }
    },
    "kimi-code": {
      "models": {
        "kimi-for-coding": {
          "capabilities": {
            "input": ["text"],
            "output": ["text"]
          },
          "name": "Kimi K2.8 Preview",
          "settings": {
            "thinking": {
              "effort": "high",
              "type": "enabled"
            }
          }
        },
        "k3.1-pro": {
          "capabilities": {
            "input": ["text"],
            "output": ["text"]
          },
          "name": "Kimi K3.1 Pro",
          "settings": {
            "thinking": {
              "effort": "high",
              "type": "enabled"
            }
          }
        }
      },
      "name": "Kimi Code",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "apiKey": "{env:KIMI_API_KEY}",
        "baseURL": "https://api.kimi.com/coding/v1"
      }
    }
  },
  "shell": "cmd",
  "skills": [
    "~/.agents/personal-skills"
  ],
  "update": "disable"
}
