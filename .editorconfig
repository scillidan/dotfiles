root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_size = 2

[*.html]
indent_size = 2

[*.{css,styl,scss,less,sass}]
indent_size = 2

[*.{js,json}]
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[*.lua]
indent_size = 2

[*.{typ,tex,sty,cls}]
indent_size = 2

[*.py]
indent_size = 4

[*.txt]
indent_size = 4
tab_width = 4

[Makefile]
indent_style = tab

[*.md]
indent_style = tab
trim_trailing_whitespace = false
